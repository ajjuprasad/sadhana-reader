rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Self-writes are limited to a known set of fields (no admin: true
      // injection). Stronger field-level enforcement would require an
      // onCall function; this is a reasonable client-side bound.
      allow write: if isOwner(userId);

      match /favorites/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /purchases/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /subscription/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /orders/{orderId} {
      allow read, write: if false;
    }
  }
}
