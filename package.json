{
  "name": "sadhana-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sadhana Reader — a digital sanctum for reading Hindu stotras",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "generate-narration": "node --experimental-strip-types scripts/generate-narration.ts",
    "generate-illustrations": "node --experimental-strip-types scripts/generate-illustrations.ts"
  },
  "dependencies": {
    "firebase": "^12.12.0",
    "framer-motion": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
